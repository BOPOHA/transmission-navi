#!/bin/bash
# Custom rpkg macros for transmission-navi. Referenced by rpkg.conf.

# Produce a deterministic dependency archive during the network-enabled SRPM
# stage. Mock consumes Source1 with -mod=vendor and does not need network access.
function go_vendor_pack {
    local tarball_name="transmission-navi-go-vendor.tar.gz"
    local module_cache="${TMPDIR:-/tmp}/transmission-navi-rpkg-gomodcache"
    local vendor_path="$PWD/vendor"

    echo "go_vendor_pack: resolving modules in $PWD" >&2
    rm -rf -- "$vendor_path"
    mkdir -p "$module_cache"
    if ! GOMODCACHE="$module_cache" go mod download >&2; then
        rm -rf -- "$vendor_path"
        return 1
    fi
    if ! GOMODCACHE="$module_cache" go mod vendor >&2; then
        rm -rf -- "$vendor_path"
        return 1
    fi
    # The current module has no third-party dependencies, so Go may omit the
    # directory entirely. Keep an explicit empty archive for a stable pipeline.
    mkdir -p "$vendor_path"
    if ! tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 \
        --numeric-owner -cf - vendor/ | gzip -n >"${OUTDIR}/${tarball_name}"; then
        rm -rf -- "$vendor_path"
        return 1
    fi
    rm -rf -- "$vendor_path"
    echo "go_vendor_pack: wrote ${OUTDIR}/${tarball_name}" >&2
    echo "$tarball_name"
}
