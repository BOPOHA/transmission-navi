[Unit]
Description=Refresh the Transmission Navi media catalog
Documentation=file:///usr/share/doc/transmission-navi/docs/installation.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=transmission
Group=transmission
UMask=0027
ExecStart=/usr/bin/navi-indexer -config /etc/transmission-navi/config.json
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/transmission-navi /var/lib/transmission-navi
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
